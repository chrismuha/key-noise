{
  "name": "docx-filler",
  "productName": "DOCX Filler",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop DOCX filler built with Electron.",
  "main": "main.js",
  "scripts": {
    "prestart": "node ../_shared/repair.mjs",
    "start": "node ../_shared/vite-electron-dev.mjs --port 5176",
    "start:fixed": "concurrently \"npm run dev:renderer\" \"cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5176/ npm run dev:main\"",
    "start:prod": "env -u ELECTRON_RUN_AS_NODE NODE_ENV=production electron .",
    "predev": "node ../_shared/repair.mjs",
    "dev": "node ../_shared/vite-electron-dev.mjs --port 5176",
    "dev:renderer": "vite dev --host 127.0.0.1 --port 5176",
    "dev:main": "env -u ELECTRON_RUN_AS_NODE NODE_ENV=development electron . --disable-cache",
    "build": "npm run dist",
    "build:web": "vite build",
    "prebuild": "node ../_shared/repair.mjs",
  "dist": "node ../_shared/run-electron-dist.mjs mac:universal",
    "dist:mac:x64": "npm run generate-icons && npm run build:web && electron-builder --mac --x64",
    "dist:mac:arm64": "npm run generate-icons && npm run build:web && electron-builder --mac --arm64",
    "dist:mac:universal": "npm run generate-icons && npm run build:web && electron-builder --mac --universal",
    "build:mac:x64": "npm run dist:mac:x64",
    "build:mac:arm64": "npm run dist:mac:arm64",
    "build:mac:universal": "npm run dist:mac:universal",
    "dist:win": "npm run generate-icons && npm run build:web && electron-builder --win",
    "dist:linux": "npm run build:web && electron-builder --linux",
    "build:win": "npm run dist:win",
    "build:linux": "npm run dist:linux",
    "package": "echo \"electron-forge package is not configured for docx-filler\"",
    "make": "echo \"electron-forge make is not configured for docx-filler\"",
    "publish": "echo \"electron-forge publish is not configured for docx-filler\"",
    "postinstall": "node ../_shared/repair.mjs",
    "lint": "echo \"No linting configured\"",
    "generate-icons": "echo \"No icon generation configured\"",
    "all": "bash ../../../SCRIPTS/script-set-1/run-all.sh",
    "scripts": "bash ../../../SCRIPTS/script-set-1/run-all.sh"
  },
  "keywords": [],
  "author": {
    "name": "Chris Muha"
  },
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.mcr.docxfiller",
    "productName": "DOCX Filler",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*",
      "build/**/*",
      "main.js",
      "package.json"
    ],
    "mac": {
      "artifactName": "docx-filler-${version}.dmg",
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "docx-filler-${version}.exe"
    }
  },
  "dependencies": {
    "pizzip": "^3.2.0",
    "vue": "^3.5.13",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.0.1",
    "electron-builder": "^26.0.12",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  }
}
